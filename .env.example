# Copy to .env.local and fill in. .env.local is never committed.

# Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively inside route handlers and server actions for
# staff account administration. It must never appear in a component, never be
# prefixed NEXT_PUBLIC_, and never be committed.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin, used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Supabase personal access token (sbp_...) belongs to the operator's shell
# environment for `supabase link` only. It is not an application secret and
# must never be added to this file.
